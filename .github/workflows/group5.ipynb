undo_stack = []
text_state = ""


def write(text):
    global text_state
    undo_stack.append(text_state)
    text_state = text


def undo():
    global text_state
    if undo_stack:
        text_state = undo_stack.pop()


def current_text():
    return text_state


write("Hello")
write("Hello World")
write("Hello World!")
print(current_text())

undo()
print(current_text())

undo()
print(current_text())
